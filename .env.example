# ---------------------------------------------------------------------------
# MeetMind environment variables
# Copy this file to `.env` and fill in the values. Never commit your real .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma
DATABASE_URL=<YOUR_VALUE>

# NextAuth / Auth.js session encryption secrets
NEXTAUTH_SECRET=<YOUR_VALUE>
AUTH_SECRET=<YOUR_VALUE>

# Abacus.AI LLM API key (transcription, summarisation, Ask AI, PDF, FFmpeg)
ABACUSAI_API_KEY=<YOUR_VALUE>

# Cloud storage (S3-compatible) configuration
AWS_PROFILE=<YOUR_VALUE>
AWS_REGION=<YOUR_VALUE>
AWS_BUCKET_NAME=<YOUR_VALUE>
AWS_FOLDER_PREFIX=<YOUR_VALUE>
